{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configurer",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}/blackhole", "-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Debug"],
            "problemMatcher": []
        },
        {
            "label": "CMake: compiler",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug", "--parallel"],
            "dependsOn": "CMake: configurer",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Lancer le trou noir",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/blackhole",
            "windows": { "command": "${workspaceFolder}\\build\\bin\\blackhole.exe" },
            "dependsOn": "CMake: compiler",
            "problemMatcher": []
        }
    ]
}
